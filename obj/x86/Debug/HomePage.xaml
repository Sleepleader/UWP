<Page
    x:Class="App2.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Grid x:ConnectionId='2' x:Name="RootGrid">

		<!-- 窗口尺寸自适应 -->
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState x:ConnectionId='3' x:Name="DefaultLayout">
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="600" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="ImageDescription.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>

				<VisualState x:ConnectionId='4' x:Name="NarrowLayout">
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="0" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="ImageDescription.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<!-- 必应背景图（底层） -->
		<Image x:ConnectionId='5'
            x:Name="BingDailyImage"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Canvas.ZIndex="-1" />

		<!-- 图片描述文本 -->
		<TextBlock x:ConnectionId='6'
            x:Name="ImageDescription"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="10"
            Foreground="White"
            FontSize="18"
            TextWrapping="Wrap" />

		<!-- 中央内容区 -->
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
            <!-- 加载动画 -->
            <ProgressRing x:ConnectionId='7'
                x:Name="LoadingRing"
                IsActive="False"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Width="50"
                Height="50"
                Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />

			<StackPanel x:ConnectionId='8' x:Name="QuotePanel">
				<TextBlock x:ConnectionId='9'
                        x:Name="QuoteContent"
                        FontSize="40"
                        
                        Margin="0,0,0,10"
                        TextWrapping="Wrap"
                        Foreground="White" />
				<TextBlock x:ConnectionId='10'
                        x:Name="QuoteAuthor"
                        FontSize="25"
                        Foreground="White"
                        HorizontalAlignment="Right" />
			</StackPanel>
		</StackPanel>
	</Grid>
</Page>

